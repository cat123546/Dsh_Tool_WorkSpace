   "正则": "(?<![0-9A-Z])[0-9A-HJ-NPQRTUWXY]{18}(?![0-9A-Z])",
   "校验": "uscc",
   "上下文": null,
   "占位符": "信用代码",
   "优先级": 6,
   "置信度": 0.9,
   "启用": true,
   "来源": "内置"
  },
  {
