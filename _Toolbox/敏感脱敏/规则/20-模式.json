{
 "层": "模式",
 "说明": "模式层：正则 + 校验位；上下文 字段用于要求前缀词",
 "版本": "2026-11-22",
 "规则": [
  {
   "id": "P-001",
   "层": "模式",
   "类别": "联系方式",
   "名称": "手机号",
   "正则": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
   "校验": "none",
   "上下文": null,
   "占位符": "手机号",
   "优先级": 10,
   "置信度": 0.99,
   "启用": true,
   "来源": "内置"
  },
  {
   "id": "P-002",
   "层": "模式",
   "类别": "身份标识",
   "名称": "身份证",
   "正则": "(?<!\\d)[1-9]\\d{5}(?:19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx](?![\\dXx])",
   "校验": "id18",
   "上下文": null,
   "占位符": "身份证",
   "优先级": 5,
   "置信度": 0.97,
   "启用": true,
   "来源": "内置"
  },
  {
   "id": "P-003",
   "层": "模式",
   "类别": "联系方式",
   "名称": "邮箱",
   "正则": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+",
   "校验": "none",
   "上下文": null,
   "占位符": "邮箱",
   "优先级": 20,
   "置信度": 0.95,
   "启用": true,
   "来源": "内置"
  },
  {
